# Firebase config — copy này thành .env.local và điền vào
# Lấy từ: Firebase Console → Project Settings → Your apps → Web app → SDK setup

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Lưu ý: Firebase API key KHÔNG phải secret thật — Firestore Security Rules
# mới là thứ bảo vệ dữ liệu. Chỉ roomId (lưu trong localStorage) là "mật khẩu" truy cập.
